# Publish only the Android source and public project documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/signing.properties.example
!/gradlew
!/gradlew.bat
!/gradle/
!/app/
!/tools/
!/docs/

/app/*
!/app/build.gradle.kts
!/app/src/
/tools/*
!/tools/sync-product-manual.cjs
/docs/*
!/docs/product-manual.md

# Private credentials, local settings, caches and generated files.
**/build/
**/.gradle/
**/.kotlin/
**/node_modules/
**/.idea/
**/__pycache__/
*.iml
*.apk
*.aab
*.keystore
*.jks
*.pem
*.key
*.p12
*.db
*.sqlite*
*.log
*.hprof
**/.env
**/.env.*
local.properties
signing.properties
